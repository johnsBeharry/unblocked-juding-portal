{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unblocked-juding-portal",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/files/*",
			"/auth/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "unblocked-judging",
			"database_id": "b1b71b30-a8df-453c-9ae2-9c8900fa4d33"
		}
	],
	"r2_buckets": [
		{
			"binding": "POSTERS",
			"bucket_name": "unblocked-posters"
		}
	],
	"vars": {
		// "magic" = Resend magic-link sessions (production). Local dev overrides
		// this with "dev" via .dev.vars, which trusts DEV_USER_EMAIL instead.
		"AUTH_MODE": "magic",
		// Comma-separated emails auto-provisioned as admins on first sign-in.
		"ADMIN_EMAILS": "team@peakshift.com",
		// Sender for sign-in emails. Resend's onboarding address only delivers to
		// the Resend account owner — verify a domain in Resend and change this
		// to e.g. "UNBLOCKED Judging <judging@peakshift.com>" before inviting judges.
		"MAIL_FROM": "UNBLOCKED Judging <onboarding@resend.dev>"
		// RESEND_API_KEY is a secret: npx wrangler secret put RESEND_API_KEY
	},
	"observability": {
		"enabled": true
	}
}
