{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unblocked-juding-portal",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"rules": [
		{ "type": "Text", "globs": ["**/*.md", "**/*.yaml"], "fallthrough": true }
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/files/*",
			"/auth/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "unblocked-judging",
			"database_id": "b1b71b30-a8df-453c-9ae2-9c8900fa4d33"
		}
	],
	"r2_buckets": [
		{
			"binding": "POSTERS",
			"bucket_name": "unblocked-posters"
		}
	],
	"vars": {
		// "magic" = Resend magic-link sessions (production). Local dev overrides
		// this with "dev" via .dev.vars, which trusts DEV_USER_EMAIL instead.
		"AUTH_MODE": "magic",
		// Comma-separated emails auto-provisioned as admins on first sign-in.
		"ADMIN_EMAILS": "team@peakshift.com",
		// Sender for sign-in emails, using the verified mail.pxpush.com domain.
		"MAIL_FROM": "UNBLOCKED Judging <judging@mail.pxpush.com>",
		// Sender for artist emails (sign-in code, receipt, withdrawal confirmation).
		"MAIL_FROM_ARTISTS": "UNBLOCKED <submissions@mail.pxpush.com>"
		// Secrets (npx wrangler secret put <NAME>):
		//   RESEND_API_KEY      Resend API key
		//   ARTIST_CODE_SECRET  random 32+ bytes; HMACs artist sign-in codes
		// Local only (.dev.vars): ARTIST_EMAIL_MODE=log prints artist emails
		// to the console instead of sending them.
	},
	"observability": {
		"enabled": true
	}
}
