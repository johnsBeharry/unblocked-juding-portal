# Ladle's built bundle (prism-react-renderer, the source-view addon) uses
# new Function() internally, which needs 'unsafe-eval'. Internal dev-facing
# component catalog only — not part of the user-facing app surface above.
/design-system/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-eval'; connect-src 'self'; font-src https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
