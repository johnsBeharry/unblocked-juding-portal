# Cloudflare merges Content-Security-Policy across every matching block
# instead of letting a more-specific path override it (CSP headers are
# additive by design — a second header can only add restrictions, never
# loosen them). So the strict policy below is scoped to the real app's
# actual static paths instead of "/*", leaving /design-system/* to its own
# separate, relaxed block further down.
/
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; font-src https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

